; Scatter-file for RAM based example on i.MX28

; This scatter-file places application code, data, stack, heap and TTB at suitable addresses in the memory map.

; i.MX28 has 128kB of internal RAM, which this scatter-file uses.

SDRAM 0x00000000 0x20000
{       
	VECTORS +0
	{
		* (VECTORS, +FIRST)     ; Vector table and other (assembler) startup code
		* (InRoot$$Sections)    ; All (library) code that must be in a root region
	}

	RO_CODE +0
	{ * (+RO-CODE) }            ; Application RO code (.text)

	RO_DATA +0
	{ * (+RO-DATA) }            ; Application RO data (.constdata)

	RW_DATA +0
	{ * (+RW) }                 ; Application RW data (.data)

	ZI_DATA +0
	{ * (+ZI) }                 ; Application ZI data (.bss)

	ARM_LIB_HEAP  0x00004000 EMPTY  0x00004000 ; Application heap
	{ }

	ARM_LIB_STACK 0x00009000 EMPTY -0x00001000 ; Application (SVC mode) stack
	{ }

	IRQ_STACK     0x0000A000 EMPTY -0x00001000 ; IRQ mode stack
	{ }

	TTB     0x00010000 EMPTY 0x4000            ; Level-1 Translation Table for MMU
	{ }

}
